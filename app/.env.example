# --- Needed already ---
OPENAI_API_KEY=
FAL_KEY=

# --- Site & films ---
NEXT_PUBLIC_SITE_URL=         # your web address, e.g. https://dreamreel.app — shown on every film's end card and used for share links
REEL_DAILY_LIMIT=8            # films one person can start per day
NARRATION_MODEL=gpt-4o-mini   # writes each film's narration

# --- Premium (built, switched off) ---
NEXT_PUBLIC_PREMIUM_ENABLED=false   # true shows the Guru, subscription and AI moving clips

# --- Premium (Stripe) ---
STRIPE_SECRET_KEY=            # Stripe → Developers → API keys (sk_live_… or sk_test_…)
STRIPE_PRICE_ID=              # the monthly £ price you create in Stripe → Product catalogue (price_…)
STRIPE_WEBHOOK_SECRET=        # Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
SUPABASE_SERVICE_ROLE_KEY=    # Supabase → Project Settings → API keys → service_role (keep secret!)
NEXT_PUBLIC_PREMIUM_PRICE_LABEL=£3.99 a month

# --- Optional tuning ---
DAILY_LIMIT=3                 # free dreams per person per day
PREMIUM_DAILY_LIMIT=5         # premium dreams per day (each moving reel costs ~£1–2)
GURU_DAILY_MESSAGES=60        # fair-use cap on Guru questions per day
GURU_MODEL=gpt-4.1            # model for readings and chat
GURU_VOICE=cedar              # OpenAI voice for the Guru
NARRATOR_VOICE=marin          # OpenAI voice that narrates films (marin, cedar, coral, sage…)
FAL_IMAGE_MODEL=fal-ai/flux/schnell                          # free pictures
FAL_IMAGE_MODEL_PREMIUM=fal-ai/flux-pro/v1.1                 # premium pictures
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video   # premium moving clips
