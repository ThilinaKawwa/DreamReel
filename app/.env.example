# --- Needed already ---
OPENAI_API_KEY=
FAL_KEY=

# --- Site & films ---
NEXT_PUBLIC_SITE_URL=         # your web address, e.g. https://dreamreel.app — shown on every film's end card and used for share links
REEL_DAILY_LIMIT=8            # films one person can start per day
NARRATION_MODEL=gpt-4o-mini   # writes each film's narration

# --- Dream Director: cinematic video films (dream-director-v2) ---
# Needs OPENAI_API_KEY, FAL_KEY, SUPABASE_SERVICE_ROLE_KEY and REEL_WORKER_SECRET. If any is missing,
# new dreams use the older picture renderer (labelled image_fallback).
REEL_WORKER_SECRET=           # any long random text (32+ characters). Lets the server continue long films. Keep secret.
REEL_DAILY_BUDGET_USD=25      # hard cap on video spend per day across ALL users; above it films use still frames
FREE_MAX_SHOTS=3              # video shots in a free film (each ~5 s ≈ $0.35 + keyframe)
PREMIUM_MAX_SHOTS=5           # video shots in a Premium film
VIDEO_PROVIDER=kling-i2v      # kling-i2v (Kling 2.5 Turbo Pro image-to-video) or kling-o1-ref (Kling O1 reference-to-video, pricier)
PREMIUM_VIDEO_PROVIDER=kling-i2v
DIRECTOR_MODEL=gpt-4.1        # writes the DreamBible and storyboard
FAL_REFERENCE_MODEL=fal-ai/nano-banana        # character / place / object reference images
FAL_KEYFRAME_MODEL=fal-ai/nano-banana/edit    # each shot's first frame, made FROM the references
FREE_SHARE_MODE=link          # none | link | file — what a free user's Share button does
PREMIUM_SHARE_MODE=file
# REEL_WORKER_URL=            # optional: your site address if NEXT_PUBLIC_SITE_URL isn't set
# Rate limits per hour (optional): RL_DREAMS_PER_HOUR=6 RL_REEL_RENDERS_PER_HOUR=6 RL_GURU_PER_HOUR=40

# --- Premium (built, switched off) ---
NEXT_PUBLIC_PREMIUM_ENABLED=false   # true shows the Guru, subscription and AI moving clips

# --- Premium (Stripe) ---
STRIPE_SECRET_KEY=            # Stripe → Developers → API keys (sk_live_… or sk_test_…)
STRIPE_PRICE_ID=              # the monthly £ price you create in Stripe → Product catalogue (price_…)
STRIPE_WEBHOOK_SECRET=        # Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
SUPABASE_SERVICE_ROLE_KEY=    # Supabase → Project Settings → API keys → service_role (keep secret!)
NEXT_PUBLIC_PREMIUM_PRICE_LABEL=£3.99 a month

# --- Optional tuning ---
DAILY_LIMIT=3                 # free dreams per person per day
PREMIUM_DAILY_LIMIT=5         # premium dreams per day (each moving reel costs ~£1–2)
GURU_DAILY_MESSAGES=60        # fair-use cap on Guru questions per day
GURU_MODEL=gpt-4.1            # model for readings and chat
GURU_VOICE=cedar              # OpenAI voice for the Guru
NARRATOR_VOICE=marin          # OpenAI voice that narrates films (marin, cedar, coral, sage…)
FAL_IMAGE_MODEL=fal-ai/flux/schnell                          # free pictures
FAL_IMAGE_MODEL_PREMIUM=fal-ai/flux-pro/v1.1                 # premium pictures
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video   # premium moving clips
