# --- Needed already ---
OPENAI_API_KEY=
FAL_KEY=

# --- Site & films ---
NEXT_PUBLIC_SITE_URL=         # your web address, e.g. https://dreamreel.app — shown on every film's end card and used for share links
REEL_DAILY_LIMIT=8            # films one person can start per day
NARRATION_MODEL=gpt-4o-mini   # writes each film's narration

# --- Dream Director: cinematic video films (dream-director-v2) ---
# Needs OPENAI_API_KEY, FAL_KEY, SUPABASE_SERVICE_ROLE_KEY and REEL_WORKER_SECRET.
REEL_WORKER_SECRET=           # any long random text (32+ characters). Server-only. Use a DIFFERENT value for Preview and Production.
REEL_DAILY_BUDGET_USD=25      # hard cap on AI video spend per UTC day (reserved before spending)
FREE_TRIAL_REELS=1            # cinematic reels a free account gets IN TOTAL
FREE_TRIAL_MAX_REFUNDS=2      # failed trial films given back (lifetime)
PREMIUM_MONTHLY_REELS=4       # cinematic reels per UK calendar month
PREMIUM_MAX_REFUNDS_PER_MONTH=3
FREE_MAX_SHOTS=3
PREMIUM_MAX_SHOTS=5
FREE_CAN_SHARE_LINK=true      # sharing is separate from downloading
FREE_CAN_SHARE_FILE=false
IDENTITY_VIDEO_PROVIDER=kling-o1-ref   # shots with a recurring person/object
SCENIC_VIDEO_PROVIDER=kling-i2v        # scenic shots
# IDENTITY_ROUTING=off                 # send every shot to the scenic model (cheaper, weaker identity)
DIRECTOR_MODEL=gpt-4.1
FAL_REFERENCE_MODEL=fal-ai/nano-banana
FAL_KEYFRAME_MODEL=fal-ai/nano-banana/edit
ADMIN_USER_IDS=               # your Supabase user id(s), comma-separated, for /api/admin/costs
REEL_DEBUG_FALLBACK=false     # true = also save a private still-image version when cinematic fails (debug only)
# Worker routing is automatic on Vercel (Preview → its own URL, Production → production domain).
# REEL_WORKER_URL=            # production: optional https override · local: http://localhost:3000 · ignored on Preview unless it is that preview
# PRODUCTION_HOSTS=           # extra production hostnames a Preview must never call (comma-separated)
# Price overrides (USD): PRICE_KLING_25_PER_S=0.07 PRICE_KLING_O1_PER_S=0.112 PRICE_NANO_BANANA=0.04 PRICE_NANO_BANANA_EDIT=0.04
# Rate limits per hour: RL_DREAMS_PER_HOUR=6 RL_REEL_RENDERS_PER_HOUR=6 RL_GURU_PER_HOUR=40 RL_GURU_VOICE_PER_HOUR=40

# --- Premium (built, switched off) ---
NEXT_PUBLIC_PREMIUM_ENABLED=false   # true shows the Guru, subscription and AI moving clips

# --- Premium (Stripe) ---
STRIPE_SECRET_KEY=            # Stripe → Developers → API keys (sk_live_… or sk_test_…)
STRIPE_PRICE_ID=              # the monthly £ price you create in Stripe → Product catalogue (price_…)
STRIPE_WEBHOOK_SECRET=        # Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
SUPABASE_SERVICE_ROLE_KEY=    # Supabase → Project Settings → API keys → service_role (keep secret!)
NEXT_PUBLIC_PREMIUM_PRICE_LABEL=£3.99 a month

# --- Optional tuning ---
DAILY_LIMIT=3                 # free dreams per person per day
PREMIUM_DAILY_LIMIT=5         # premium dreams per day (each moving reel costs ~£1–2)
GURU_DAILY_MESSAGES=60        # fair-use cap on Guru questions per day
GURU_MODEL=gpt-4.1            # model for readings and chat
GURU_VOICE=cedar              # OpenAI voice for the Guru
NARRATOR_VOICE=marin          # OpenAI voice that narrates films (marin, cedar, coral, sage…)
FAL_IMAGE_MODEL=fal-ai/flux/schnell                          # free pictures
FAL_IMAGE_MODEL_PREMIUM=fal-ai/flux-pro/v1.1                 # premium pictures
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video   # premium moving clips
